DOLA_DATA_DIR=/var/lib/dola-fetch-service
DOLA_CONFIG_PATH=/var/lib/dola-fetch-service/config.json
DOLA_DEFAULT_PROXY_API_URL=https://example.com/get-proxy?num=1&type=txt
DOLA_DATABASE_URL=postgresql://dola:change-me@127.0.0.1:5432/dola
DOLA_DATABASE_POOL_SIZE=24
DOLA_DATABASE_POOL_TIMEOUT=3
DOLA_QUEUE_BACKEND=redis
DOLA_REDIS_URL=redis://127.0.0.1:6379/0
DOLA_QUEUE_NAMESPACE=dola:tasks
DOLA_QUEUE_VISIBILITY_TIMEOUT=180
DOLA_PORT=8088
DOLA_IMAGE_NAME=dola-fetch-service
DOLA_IMAGE_TAG=1.10.39
POSTGRES_DB=dola
POSTGRES_USER=dola
POSTGRES_PASSWORD=change-me
DOLA_ADMIN_USERNAME=admin
DOLA_ADMIN_PASSWORD=change-me-now
DOLA_PLATFORM_RATE_PER_MINUTE=30
DOLA_PLATFORM_BURST=5
DOLA_CIRCUIT_FAILURE_THRESHOLD=5
DOLA_CIRCUIT_RECOVERY_SECONDS=60
DOLA_QUEUE_HIGH_WATERMARK=1000
DOLA_MEMORY_HIGH_RATIO=0.81
DOLA_MEMORY_CRITICAL_RATIO=0.90
DOLA_MINIMUM_WORKERS=1
DOLA_MAX_EFFECTIVE_WORKERS=48
DOLA_RESULT_POLL_CONCURRENCY=16
DOLA_RESULT_POLL_RATE_PER_SECOND=8
DOLA_RESULT_POLL_BATCH_SIZE=256
DOLA_RESULT_POLL_INTERVAL_SECONDS=20
DOLA_IMAGE_UPLOAD_CONCURRENCY=10
DOLA_IMAGE_PREPARE_CONCURRENCY=15
DOLA_PREPARE_UPLOAD_TIMEOUT_SECONDS=60
DOLA_IMAGE_UPLOAD_SLOT_WAIT_SECONDS=20
DOLA_API_PROXY_ENDPOINT_LIMIT=20
DOLA_API_PROXY_CONTEXTS_PER_ENDPOINT=1
DOLA_MIHOMO_EXIT_SLOTS=15
DOLA_MIHOMO_CONTEXTS_PER_EXIT=1
DOLA_REFERENCE_CACHE_TTL_SECONDS=1800
DOLA_REFERENCE_CACHE_MAX_ENTRIES=512
DOLA_SLIDER_ENABLED=true
DOLA_SLIDER_MAX_ATTEMPTS=3
DOLA_SLIDER_VERIFY_TIMEOUT_SECONDS=5
DOLA_SLIDER_MINIMUM_CONFIDENCE=0.45
DOLA_API_MAX_CONNECTIONS=512
DOLA_API_HEALTH_FAILURES_BEFORE_RESTART=5
DOLA_API_HEALTH_TIMEOUT_SECONDS=4
DOLA_API_FD_RESTART_THRESHOLD=4096
DOLA_NOFILE_SOFT_LIMIT=65535
DOLA_NOFILE_HARD_LIMIT=65535
DOLA_API_MEMORY_LIMIT=3G
DOLA_WORKER_MEMORY_LIMIT=8G
DOLA_WORKER_SHM_SIZE=1gb

DEPLOY_HOST=your.server.ip
DEPLOY_USER=root
DEPLOY_PASSWORD=change-me
